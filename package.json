{
  "name": "controlfreak-design",
  "version": "0.8.1",
  "description": "Shared look for the ControlFreak family of orienteering apps: colour tokens, Tailwind theme, font, logo, icons, the start screen, the credit with the authors, the family's languages, and the family header and footer.",
  "license": "MIT",
  "author": "Henrik Flordal",
  "repository": {
    "type": "git",
    "url": "https://github.com/HenrikF/controlfreak-design.git"
  },
  "files": [
    "css",
    "assets",
    "scripts",
    "dist",
    "icons.js",
    "icons.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./tokens.css": "./css/tokens.css",
    "./theme.css": "./css/theme.css",
    "./fonts.css": "./css/fonts.css",
    "./splash.css": "./css/splash.css",
    "./assets/*": "./assets/*",
    "./icons": {
      "types": "./icons.d.ts",
      "default": "./icons.js"
    },
    "./splash": {
      "types": "./dist/splash/index.d.ts",
      "default": "./dist/splash/index.js"
    },
    "./credits": {
      "types": "./dist/credits/index.d.ts",
      "default": "./dist/credits/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./family": {
      "types": "./dist/family/index.d.ts",
      "default": "./dist/family/index.js"
    },
    "./family.css": "./css/family.css",
    "./package.json": "./package.json"
  },
  "style": "./css/tokens.css",
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
